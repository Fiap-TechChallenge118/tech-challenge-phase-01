# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
#
# O profile deve estar configurado em ~/.aws/credentials
# Para verificar os profiles disponíveis: aws configure list-profiles

AWS_PROFILE=default

# Região AWS — usada pelo Makefile e AWS CLI.
# Para o Terraform, altere aws_region em infra/terraform.tfvars.
AWS_REGION=us-east-1
